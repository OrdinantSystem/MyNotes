---
import Math from './Math.astro';import MathText from './MathText.astro';
import {casesFigures,isCasesFigure,type CasesFigure} from '../lib/interactive/cases-model';
import {remainder} from '../lib/interactive/equivalence-model';
import {caseTex as t,squareGrid} from '../lib/interactive/cases-render';
import {casesText} from '../lib/reasoning/cases-copy';
import '../styles/counterexamples.css';import '../styles/discovery.css';import '../styles/cases.css';
interface Props{kind:CasesFigure}
const {kind}=Astro.props,locale=Astro.locals.locale||'en',c=casesText(locale);
if(!isCasesFigure(kind))throw new Error('Unknown cases figure');
const even=locale==='de'?'gerade':'even';
const parityClaim=(square=false)=>String.raw`n${square?'^2':''}\text{ ${even}}`;
const closed=kind==='cases-equivalence',direction=kind==='cases-forward'||kind==='cases-reverse'||closed;
---
<figure class="counter-figure cases-figure" data-cases-figure={kind}>
 <h3>{c.figureTitles[casesFigures.indexOf(kind)]}</h3>
 {kind==='cases-parity'&&<><div class="cases-strip-scroll" tabindex="0" role="region" aria-label={c.figureTitles[0]}><div class="cases-strip">{Array.from({length:9},(_,i)=>i-4).map(n=><span class:list={['cases-number',`cases-role-${remainder(n,2)}`]}><strong>{n<0?'−'+(-n):n}</strong><small>{remainder(n,2)===0?c.even:c.odd}</small></span>)}</div></div><figcaption>{c.parityCaption}</figcaption></>}
 {kind==='cases-possibilities'&&<div class="cases-branches">{[[4,5],[5,6]].map((ns,i)=><section class="cases-branch"><h4>{c.case} {i+1}</h4><div class="cases-sample"><strong>{ns[0]}</strong><span>→</span><strong>{ns[1]}</strong></div><p>{i===0?c.evenReason:c.oddReason}</p></section>)}</div>}
 {kind==='cases-routes'&&<><p class="cases-root"><MathText text={c.arbitrary}/></p><div class="cases-arrow" aria-hidden="true">↓</div><div class="cases-branches">{[c.evenAssumption,c.oddAssumption].map((text,i)=><section class="cases-branch"><h4><MathText text={text}/></h4><p>{i===0?c.evenReason:c.oddReason}</p></section>)}</div><div class="cases-arrow" aria-hidden="true">↓</div><div class="cases-result"><Math tex={t.productConclusion} display/></div><figcaption>{c.exhaustive}</figcaption></>}
 {(kind==='cases-workspace'||kind==='cases-square-workspace'||kind==='cases-reverse-workspace')&&<div class="discovery-columns"><section class="discovery-panel discovery-known"><h4>{c.have}</h4><Math tex={kind==='cases-workspace'?t.integer:kind==='cases-square-workspace'?t.even:t.squareAssumed} display/>{kind==='cases-square-workspace'&&<Math tex={t.kInteger} display/>}</section><section class="discovery-panel discovery-goal"><h4>{c.need}</h4><Math tex={kind==='cases-workspace'?t.target:kind==='cases-square-workspace'?t.squareTarget:t.reverseTarget} display/><p>{c.target}</p></section></div>}
 {kind==='cases-even-pairs'&&<><div class="cases-pair-product">{[0,1].map(extra=><div><div class="discovery-objects">{Array.from({length:4},()=> <span class:list={['discovery-pair',extra?'discovery-odd':'discovery-even']} role="img" aria-label={c.pair}><i/><i/></span>)}{extra===1&&<span class="discovery-leftover">+1</span>}</div><Math tex={extra?'2k+1':'2k'} display/></div>)}<span class="visually-hidden">×</span></div><Math tex="(2k)(2k+1)" display/><figcaption><MathText text={c.pairsCaption}/></figcaption></>}
 {kind==='cases-even-match'&&<><div class="discovery-columns"><section><h4>{c.obtained}</h4><Math tex={t.match} display/></section><section><h4>{c.required}</h4><Math tex={t.twoM} display/></section></div><div class="cases-result"><Math tex={t.evenWitness} display/></div><figcaption><MathText text={c.matchCaption}/></figcaption></>}
 {kind==='cases-odd-successor'&&<><div class="discovery-objects">{Array.from({length:3},()=> <span class="discovery-pair discovery-odd" role="img" aria-label={c.pair}><i/><i/></span>)}<span class="discovery-leftover">1 + 1</span></div><p class="cases-arrow" aria-hidden="true">↓</p><div class="discovery-objects">{Array.from({length:4},()=> <span class="discovery-pair discovery-even" role="img" aria-label={c.pair}><i/><i/></span>)}</div><Math tex={t.successor} display/><figcaption>{c.successorCaption}</figcaption></>}
 {kind==='cases-completed'&&<><div class="cases-root"><Math tex={t.integer} display/></div><div class="cases-branches">{[0,1].map(i=><section class="cases-branch"><h4><MathText text={i?c.oddAssumption:c.evenAssumption}/></h4><Math tex={i?t.oddAssumed:t.evenAssumed} display/><Math tex={i?t.oddProduct:t.evenProduct} display/><Math tex={i?t.oddWitness:t.evenWitness} display/></section>)}</div><div class="cases-result"><Math tex={t.productConclusion} display/></div><figcaption>{c.exhaustive}</figcaption></>}
 {kind==='cases-missing-zero'&&<><div class="cases-branches"><section class="cases-branch"><h4>{c.negative}</h4><Math tex="n<0" display/></section><section class="cases-branch"><h4>{c.positive}</h4><Math tex="n>0" display/></section></div><p class="cases-root cases-error">0 — {c.uncovered}</p><details><summary>{c.revealZero}</summary><p><MathText text={c.zero}/></p></details></>}
 {kind==='cases-coverage'&&<>{c.coverageTitles.map((title,i)=><section class="cases-coverage-block"><h4>{title}</h4><div class="cases-coverage-band"><span class="a">{c.caseA}</span>{i!==1&&<span class={i===0?'gap':'both'}>{i===0?c.gap:c.both}</span>}<span class="b">{c.caseB}</span></div><p>{c.coverageDetails[i]}</p></section>)}</>}
 {kind==='cases-logic'&&<><div class="cases-root"><Math tex="P\lor Q" display/></div><div class="cases-branches">{['P','Q'].map(letter=><section class="cases-branch"><h4><Math tex={letter}/></h4><Math tex={`${letter}\\Rightarrow R`} display/></section>)}</div><div class="cases-result"><Math tex="R" display/></div><Math tex={t.logic} display/><figcaption><MathText text={c.logicCaption}/></figcaption></>}
 {kind==='cases-square-samples'&&<>{[2,3,4,5].map(n=><div class="cases-sample"><strong class={`cases-role-${remainder(n,2)}`}>{n}</strong><Math tex="x\mapsto x^2"/><strong class={`cases-role-${remainder(n,2)}`}>{n*n}</strong></div>)}<figcaption>{c.sampleCaption}</figcaption></>}
 {kind==='cases-properties'&&<div class="discovery-columns"><section class="discovery-panel discovery-known"><h4>P</h4><p><MathText text={c.p}/></p></section><section class="discovery-panel discovery-goal"><h4>Q</h4><p><MathText text={c.q}/></p></section></div>}
 {direction&&<><div class="cases-direction"><div class="discovery-panel"><Math tex={parityClaim()} display/></div><div class="cases-arrow"><Math tex={t.squareForward}/><span aria-hidden="true"> →</span><p>{closed?c.direct:c.forward}</p></div><div class="discovery-panel"><Math tex={parityClaim(true)} display/></div></div>{kind!=='cases-forward'&&<div class:list={['cases-root',!closed&&'pending']}><Math tex={t.squareReverse} display/><p>{closed?c.contra:c.pending}</p></div>}{closed&&<><Math tex={t.both} display/><figcaption><MathText text={c.equivalenceCaption}/></figcaption></>}</>}
 {kind==='cases-even-square'&&<><div set:html={squareGrid(locale,6,false)}/><Math tex={t.evenSquare} display/><figcaption><MathText text={c.evenSquareCaption}/></figcaption></>}
 {(kind==='cases-eliminate-before'||kind==='cases-eliminate-after')&&<><p class="cases-root"><MathText text={c.assumeSquare}/></p><div class="cases-branches"><section class="cases-branch"><h4><MathText text={c.evenAssumption}/></h4><p>{c.compatible}</p></section><section class:list={['cases-branch',kind==='cases-eliminate-after'&&'excluded']}><h4><MathText text={c.oddAssumption}/></h4><p>{kind==='cases-eliminate-after'?c.incompatible:c.investigate}</p></section></div>{kind==='cases-eliminate-after'&&<p class="cases-result">{c.onlyEven}</p>}</>}
 {kind==='cases-three-branches'&&<><div class="cases-root"><Math tex={t.integer} display/></div><div class="cases-branches three">{t.threeForms.map((form,i)=><section class="cases-branch"><h4>{c.case} {i+1}</h4><Math tex={form} display/><Math tex={t.kInteger} display/><p class="cases-arrow" aria-hidden="true">↓</p><Math tex={t.threeFactors[i]} display/></section>)}</div><div class="cases-result"><Math tex={t.threeConclusion} display/></div><figcaption><MathText text={c.threeCaption}/></figcaption></>}
 {kind==='cases-architecture'&&<div class="discovery-columns"><section class="discovery-panel discovery-known"><h4>{c.architectureCases}</h4><Math tex="P\lor Q" display/><Math tex="P\Rightarrow R" display/><Math tex="Q\Rightarrow R" display/><p>{c.architectureCasesDetail}</p></section><section class="discovery-panel discovery-goal"><h4>{c.architectureEquiv}</h4><Math tex={t.squareForward} display/><Math tex={t.squareReverse} display/><p>{c.architectureEquivDetail}</p></section></div>}
 {kind==='cases-divisibility'&&<div class="discovery-columns"><section class="discovery-panel"><h4>{c.forward}: ?</h4><Math tex={t.divForward} display/></section><section class="discovery-panel"><h4>{c.reverse}: ?</h4><Math tex={t.divReverse} display/></section></div>}
 {kind==='cases-absolute'&&<><svg class="cases-graph" viewBox="0 0 600 400" role="img" aria-label="y = |x|; y = x"><path class="axis" d="M100 220H500M300 50V380"/><path class="abs" d="M150 70 300 220 450 70"/><path class="identity" d="M150 370 450 70"/>{[-3,-2,-1,0,1,2,3].map(x=><g><path class="axis" d={`M${300+x*50} 215V225`}/><text x={300+x*50} y="247" text-anchor="middle">{x<0?'−'+(-x):x}</text></g>)}<text x="510" y="225">x</text><text x="310" y="48">y</text></svg><figcaption><MathText text={c.absoluteCaption}/></figcaption></>}
</figure>
