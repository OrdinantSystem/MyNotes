---
import {initialDependenceState,dependencePresets,people,letters,type DependencePreset} from '../../lib/interactive/dependence-model';
import {dependenceText} from '../../lib/reasoning/dependence-copy';
import {networkMarkup,studentsMarkup} from '../../lib/interactive/dependence-render';
import '../../styles/counterexamples.css';import '../../styles/dependence.css';
interface Props{preset:DependencePreset;id:string}
const {preset,id}=Astro.props,locale=Astro.locals.locale||'en',c=dependenceText(locale),s=initialDependenceState();
if(!(dependencePresets as readonly string[]).includes(preset))throw new Error('Unknown dependence preset');
---
<figure class="counter-lab dependence-lab" id={id} data-dependence-lab={preset} data-locale={locale}>
 <h3>{c[preset]}</h3>
 {preset==='network'?<><div class="counter-controls" role="group" aria-label={c.network}>{c.modes.map((label,i)=><button type="button" data-network-mode={i?'shared':'cycle'} aria-pressed={i===0} aria-controls={`${id}-view`}>{label}</button>)}</div><div id={`${id}-view`} data-dependence-view set:html={networkMarkup(locale,s.mode,s.selected,id)}/><p class="counter-help">{c.choose}</p><div class="counter-controls" role="group" aria-label={c.choose}>{people.map((person,i)=><button type="button" data-network-person={i} aria-pressed={i===s.selected} aria-label={person} aria-controls={`${id}-view`}>{letters[i]} · {person}</button>)}</div></>:<><div class="counter-controls"><button type="button" data-student-toggle aria-pressed="false" aria-controls={`${id}-view`}>{c.add}</button></div><div id={`${id}-view`} data-dependence-view set:html={studentsMarkup(locale,false)}/></>}
 <div class="counter-controls"><button type="button" data-dependence-reset>{c.reset}</button></div><figcaption>{preset==='network'?c.networkHelp:c.studentHelp}</figcaption><p class="visually-hidden" role="status" aria-live="polite" data-dependence-status></p>
</figure>
<script>
import type {Locale} from '../../lib/i18n';
import {initialDependenceState,type NetworkMode} from '../../lib/interactive/dependence-model';
import {networkMarkup,studentsMarkup} from '../../lib/interactive/dependence-render';
import {dependenceText} from '../../lib/reasoning/dependence-copy';
for(const root of document.querySelectorAll<HTMLElement>('[data-dependence-lab]')){
 const locale=root.dataset.locale as Locale,c=dependenceText(locale),state=initialDependenceState(),preset=root.dataset.dependenceLab;
 function draw(){
  root.querySelector<HTMLElement>('[data-dependence-view]')!.innerHTML=preset==='network'?networkMarkup(locale,state.mode,state.selected,root.id):studentsMarkup(locale,state.includeLea);
  root.querySelectorAll<HTMLButtonElement>('[data-network-mode]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.networkMode===state.mode)));
  root.querySelectorAll<HTMLButtonElement>('[data-network-person]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.networkPerson)===state.selected)));
  const toggle=root.querySelector<HTMLButtonElement>('[data-student-toggle]');if(toggle){toggle.textContent=state.includeLea?c.remove:c.add;toggle.setAttribute('aria-pressed',String(state.includeLea));}
  root.querySelector<HTMLElement>('[data-dependence-status]')!.textContent=preset==='network'?root.querySelector<HTMLElement>('.dependence-pair')!.innerText:state.includeLea?c.failedStudents:c.initialStudents;
 }
 root.querySelectorAll<HTMLButtonElement>('[data-network-mode]').forEach(b=>b.addEventListener('click',()=>{state.mode=b.dataset.networkMode as NetworkMode;draw();}));
 root.querySelectorAll<HTMLButtonElement>('[data-network-person]').forEach(b=>b.addEventListener('click',()=>{state.selected=Number(b.dataset.networkPerson);draw();}));
 root.querySelector('[data-student-toggle]')?.addEventListener('click',()=>{state.includeLea=!state.includeLea;draw();});
 root.querySelector('[data-dependence-reset]')!.addEventListener('click',()=>{Object.assign(state,initialDependenceState());draw();});
}
</script>
