---
import MathText from '../MathText.astro';
import {initialContraState,contraPresets,type ContraPreset} from '../../lib/interactive/contraposition-model';
import {truthMarkup,squareMarkup,strategyTex} from '../../lib/interactive/contraposition-render';
import {justificationMath as math} from '../../lib/interactive/justification-render';
import {contraText} from '../../lib/reasoning/contraposition-copy';
import '../../styles/counterexamples.css';import '../../styles/discovery.css';import '../../styles/cases.css';import '../../styles/contraposition.css';
interface Props{preset:ContraPreset;id:string}
const {preset,id}=Astro.props,locale=Astro.locals.locale||'en',c=contraText(locale),s=initialContraState();
if(!(contraPresets as readonly string[]).includes(preset))throw new Error('Unknown contraposition preset');
---
<figure class="counter-lab contra-lab" id={id} data-contra-lab={preset} data-locale={locale}>
 <h3>{c.titles[preset]}</h3>
 {preset==='truth'?<>
  <div class="contra-booleans">{(['p','q'] as const).map(key=><fieldset><legend>{key.toUpperCase()}</legend>{[true,false].map(v=><label><input type="radio" name={`${id}-${key}`} value={String(v)} data-contra-boolean={key} checked={s[key]===v} aria-controls={`${id}-output`}/>{v?c.true:c.false}</label>)}</fieldset>)}</div>
  <div id={`${id}-output`} data-contra-output set:html={truthMarkup(locale,s.p,s.q)}/><figcaption>{c.truthPrompt}</figcaption>
 </>:preset==='odd-square'?<>
  <div class="cases-inputs"><label for={`${id}-number`}>{c.k}<input id={`${id}-number`} type="number" min="1" max="6" step="1" value={s.k} data-contra-number aria-controls={`${id}-output`}/></label></div>
  <label class="cases-range-label" for={`${id}-range`}>{c.k}<input id={`${id}-range`} type="range" min="1" max="6" step="1" value={s.k} data-contra-range aria-controls={`${id}-output`}/></label>
  <div id={`${id}-output`} data-contra-output set:html={squareMarkup(locale,s.k)}/><figcaption>{c.areaCaption}</figcaption>
 </>:<>
  <p>{c.strategyPrompt}</p>
  {c.problems.map((problem,i)=><section data-contra-problem={i} hidden={i!==0}>
   {i===2&&<p><em>{c.added}</em></p>}
   <h4><MathText text={problem.replace(/\bn\b/g,'$n$')}/></h4><div set:html={math(strategyTex(i,locale),locale)}/>
   <fieldset class="discovery-question"><legend>{c.titles.strategy}</legend>{[c.direct,c.negated].map((option,j)=><label><input type="radio" name={`${id}-route-${i}`} data-contra-answer={`${i}:${j}`} aria-controls={`${id}-feedback-${i}`}/><span>{option}</span></label>)}</fieldset>
   <div id={`${id}-feedback-${i}`} data-contra-feedback={i}/>
   <details><summary>{c.reference}</summary><p><MathText text={c.reasons[i]}/></p></details>
  </section>)}
  <div class="contra-problem-nav"><button type="button" data-contra-nav="-1" disabled>{c.previous}</button><button type="button" data-contra-nav="1">{c.next}</button></div>
 </>}
 <div class="counter-controls"><button type="button" data-contra-reset>{c.reset}</button></div><p class="visually-hidden" role="status" aria-live="polite" data-contra-status></p>
</figure>
<script>
import type {Locale} from '../../lib/i18n';
import {initialContraState,contraInput,squareRegions,strategyAnswer} from '../../lib/interactive/contraposition-model';
import {truthMarkup,squareMarkup,strategyFeedback} from '../../lib/interactive/contraposition-render';
import {contraText} from '../../lib/reasoning/contraposition-copy';
for(const root of document.querySelectorAll<HTMLElement>('[data-contra-lab]')){
 const preset=root.dataset.contraLab!,locale=root.dataset.locale as Locale,c=contraText(locale);let s=initialContraState();
 const output=root.querySelector<HTMLElement>('[data-contra-output]'),status=root.querySelector<HTMLElement>('[data-contra-status]')!,number=root.querySelector<HTMLInputElement>('[data-contra-number]'),range=root.querySelector<HTMLInputElement>('[data-contra-range]');
 const draw=()=>{if(preset==='truth')output!.innerHTML=truthMarkup(locale,s.p,s.q);if(preset==='odd-square'){output!.innerHTML=squareMarkup(locale,s.k);number!.value=String(s.k);range!.value=String(s.k);}if(preset==='strategy'){root.querySelectorAll<HTMLElement>('[data-contra-problem]').forEach(e=>e.hidden=Number(e.dataset.contraProblem)!==s.problem);root.querySelectorAll<HTMLButtonElement>('[data-contra-nav]').forEach(b=>b.disabled=Number(b.dataset.contraNav)<0?s.problem===0:s.problem===2);}};
 const announce=()=>{status.textContent=preset==='truth'?c.same:preset==='odd-square'?`${c.k}: ${s.k}; ${squareRegions(s.k).square} = 2 × ${squareRegions(s.k).pairs} + 1`:c.problems[s.problem];};
 root.querySelectorAll<HTMLInputElement>('[data-contra-boolean]').forEach(input=>input.addEventListener('change',()=>{if(!input.checked)return;s[input.dataset.contraBoolean as 'p'|'q']=input.value==='true';draw();announce();}));
 const commit=()=>{const next=contraInput(number!.value);if(next===null){number!.value=String(s.k);status.textContent=c.invalid;}else{s.k=next;draw();announce();}};
 number?.addEventListener('input',()=>{const next=contraInput(number.value);if(next!==null){s.k=next;draw();announce();}});number?.addEventListener('blur',commit);number?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();commit();}});
 range?.addEventListener('input',()=>{s.k=Number(range.value);draw();announce();});
 root.querySelectorAll<HTMLButtonElement>('[data-contra-nav]').forEach(b=>b.addEventListener('click',()=>{s.problem=Math.max(0,Math.min(2,s.problem+Number(b.dataset.contraNav)));draw();announce();}));
 root.querySelectorAll<HTMLInputElement>('[data-contra-answer]').forEach(input=>input.addEventListener('change',()=>{if(!input.checked)return;const [row,choice]=input.dataset.contraAnswer!.split(':').map(Number);s.answers[row]=choice;const feedback=root.querySelector<HTMLElement>(`[data-contra-feedback="${row}"]`)!;feedback.innerHTML=strategyFeedback(locale,row,choice);status.textContent=strategyAnswer(row,choice)?c.suggested:c.compare;}));
 root.querySelector('[data-contra-reset]')?.addEventListener('click',()=>{s=initialContraState();root.querySelectorAll<HTMLInputElement>('[data-contra-boolean]').forEach(input=>input.checked=s[input.dataset.contraBoolean as 'p'|'q']=== (input.value==='true'));root.querySelectorAll<HTMLInputElement>('[data-contra-answer]').forEach(input=>input.checked=false);root.querySelectorAll<HTMLElement>('[data-contra-feedback]').forEach(e=>e.innerHTML='');root.querySelectorAll('details').forEach(e=>e.open=false);draw();status.textContent=c.reset;});
}
</script>
