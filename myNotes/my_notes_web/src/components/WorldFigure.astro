---
import Math from './Math.astro';
import {eightObjects,setTex,type WorldFigure} from '../lib/interactive/world-model';
import {worldText} from '../lib/reasoning/world-copy';
import {worldShape,worldObjectCard,worldDescription} from '../lib/interactive/world-render';
import '../styles/counterexamples.css';import '../styles/worlds.css';
interface Props{kind:WorldFigure}
const {kind}=Astro.props,locale=Astro.locals.locale||'en',c=worldText(locale),title=kind==='world-inventory'?c.inventory:kind==='world-membership'?c.membership:kind==='world-empty'?c.empty:c.drawings;
const membershipPositions:Record<string,[number,number]>={a:[135,180],e:[235,180],c:[330,130],g:[330,240],b:[525,90],h:[585,90],d:[525,245],f:[585,245]};
const emptyPositions:Record<string,[number,number]>={a:[120,140],b:[210,140],e:[120,225],h:[210,225],c:[430,140],d:[520,140],g:[430,225],f:[520,225]};
---
<figure class="counter-figure world-figure"><h3>{title}</h3>
 {kind==='world-inventory'&&<><div class="world-classifications">{(['red','blue'] as const).flatMap(color=>([3,4] as const).map(sides=><section class="counter-case"><h4>{color==='red'?c.red:c.blue} · {sides} {c.sides}</h4><div class="world-classify-items">{eightObjects.filter(o=>o.color===color&&o.sides===sides).map(o=><Fragment set:html={worldObjectCard(o,locale,false)}/>)}</div></section>))}</div><figcaption>{c.complete}</figcaption></>}
 {kind==='world-membership'&&<><svg class="world-scene" viewBox="0 0 640 360" role="img" aria-label={`${c.membership}. ${eightObjects.map(o=>worldDescription(o,locale)).join('; ')}`}><rect class="world-frame" x="10" y="10" width="620" height="340" rx="8"/><ellipse class="world-region world-region-red" cx="240" cy="180" rx="210" ry="140"/><ellipse class="world-subset" cx="185" cy="180" rx="95" ry="65"/><g class="world-region-label"><text x="28" y="47">U</text><text x="370" y="110">R</text><text x="185" y="97" text-anchor="middle">{'{a,e}'}</text></g><Fragment set:html={eightObjects.map(o=>worldShape(o,...membershipPositions[o.id])).join('')}/></svg><div class="counter-columns"><Math tex={String.raw`a\in R`} display/><Math tex={String.raw`${setTex(['a','e'])}\subseteq R`} display/></div><figcaption>{c.membershipHelp}</figcaption></>}
 {kind==='world-empty'&&<><svg class="world-scene" viewBox="0 0 640 340" role="img" aria-label={c.emptyHelp}><rect class="world-frame" x="10" y="10" width="620" height="320" rx="8"/><circle class="world-region world-region-triangle" cx="165" cy="175" r="130"/><circle class="world-region world-region-square" cx="475" cy="175" r="130"/><g class="world-region-label"><text x="28" y="47">U</text><text x="150" y="78">T</text><text x="460" y="78">S</text><text x="320" y="185" text-anchor="middle">∅</text></g><Fragment set:html={eightObjects.map(o=>worldShape(o,...emptyPositions[o.id])).join('')}/></svg><Math tex={String.raw`T\cap S=\varnothing`} display/><figcaption>{c.emptyHelp}</figcaption></>}
 {kind==='world-drawings'&&<><div class="counter-columns">{[false,true].map(overlap=><section class="world-drawing"><h4>{overlap?c.drawingB:c.drawingA}</h4><svg class="world-scene" viewBox="0 0 320 230" role="img" aria-label={overlap?c.overlap:c.separated}><rect class="world-frame" x="5" y="5" width="310" height="220" rx="8"/><circle class="world-region world-region-red" cx="130" cy="120" r="85"/><circle class="world-region world-region-triangle" cx="105" cy="120" r="35"/><circle class="world-region world-region-square" cx={overlap?228:270} cy={overlap?140:120} r={overlap?67:38}/><circle class="world-region world-region-red world-outline" cx="130" cy="120" r="85"/><g class="world-region-label"><text x="150" y="85">R</text><text x="95" y="130">T</text><text x={overlap?230:260} y={overlap?150:130}>S</text></g></svg><Math tex={String.raw`T\subseteq R`} display/><p>{overlap?c.overlap:c.separated}</p></section>)}</div><figcaption>{c.drawingHelp}</figcaption></>}
</figure>
