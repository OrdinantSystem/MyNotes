---
import Math from './Math.astro';
import {dependenceText} from '../lib/reasoning/dependence-copy';
import {networkState,letters,people,acquaintanceCounts,citationSummary,dependenceTex,type DependenceFigure} from '../lib/interactive/dependence-model';
import '../styles/counterexamples.css';import '../styles/dependence.css';
interface Props{kind:DependenceFigure}
const {kind}=Astro.props,c=dependenceText(Astro.locals.locale||'en'),truth=(v:boolean)=>v?c.true:c.false,s=networkState('cycle',0);
const title=kind==='quantifier-symbols'?c.symbols:kind==='dependent-choices'?c.choices:kind==='quantifier-orders'?c.orders:kind==='real-choices'?c.reals:kind==='quantifier-negation'?c.negation:kind==='existence-counts'?c.counts:c.citation;
---
<figure class="counter-figure dependence-figure"><h3>{title}</h3>
 {kind==='quantifier-symbols'&&<div class="counter-columns dependence-columns">{[[String.raw`\forall`,c.all,c.allHelp],[String.raw`\exists`,c.exists,c.someHelp]].map(([tex,label,help])=><section class="counter-case"><Math tex={tex} display/><h4>{label}</h4><p>{help}</p></section>)}</div>}
 {kind==='dependent-choices'&&<><div class="dependence-choice-rows">{letters.map((letter,i)=><div class="dependence-choice-row"><strong>{letter} · {people[i]}</strong><span aria-hidden="true">→</span><strong>{letters[s.cells[i].findIndex(Boolean)]} · {people[s.cells[i].findIndex(Boolean)]}</strong></div>)}</div><figcaption>{c.choicesHelp}</figcaption></>}
 {kind==='quantifier-orders'&&<div class="counter-columns dependence-columns"><section class="counter-case"><h4>{c.everyone}</h4><Math tex={dependenceTex.separate} display/><p><strong data-truth-value={Number(s.separate)}>{truth(s.separate)}</strong></p><div class="dependence-choice-rows">{letters.map((letter,i)=><div class="dependence-choice-row"><strong>{letter}</strong><span aria-hidden="true">→</span><strong>{letters[s.cells[i].findIndex(Boolean)]}</strong></div>)}</div><p>{c.dependent}</p></section><section class="counter-case"><h4>{c.shared}</h4><Math tex={dependenceTex.common} display/><p><strong data-truth-value={Number(s.common)}>{truth(s.common)}</strong></p><p>A, B, C → ?</p><p>{c.independent}</p></section></div>}
 {kind==='real-choices'&&<div class="counter-columns dependence-columns"><section class="counter-case"><h4>{c.after}</h4><Math tex="y=x+1" display/><strong>{c.possible}</strong><p>{c.larger}</p></section><section class="counter-case"><h4>{c.once}</h4><Math tex={String.raw`\exists y\in\mathbb R\;\forall x\in\mathbb R:\ y>x`} display/><strong>{c.impossible}</strong><p>{c.greatest}</p></section></div>}
 {kind==='quantifier-negation'&&<><div class="counter-columns dependence-columns"><section class="counter-case"><Math tex={String.raw`\neg\forall s\;\cdots\quad\equiv\quad\exists s\;\neg(\cdots)`} display/></section><section class="counter-case"><Math tex={String.raw`\neg\exists p\;S(s,p)\quad\equiv\quad\forall p\;\neg S(s,p)`} display/></section></div><Math tex={String.raw`\neg(\forall s\;\exists p\;S(s,p))\equiv\exists s\;\forall p\;\neg S(s,p)`} display/><figcaption>{c.negationHelp}</figcaption></>}
 {kind==='existence-counts'&&<div class="dependence-counts">{acquaintanceCounts.map(({n,some})=><section class="counter-case"><h4>{n===0?c.nobody:n===1?'Ben':'Ben & Clara'}</h4><strong>{n}</strong><p>{n===1?c.contact:c.contacts}</p><p data-truth-value={Number(some)}>{truth(some)}</p></section>)}</div>}
 {kind==='citation-witnesses'&&<><div class="dependence-choice-rows">{[1,2,3].map(n=><div class="dependence-choice-row"><strong>{c.book} {n}</strong><span aria-hidden="true">→</span><strong>{c.source} {n}</strong></div>)}</div><p>{c.citationHelp}</p><div class="dependence-verdict"><Math tex={dependenceTex.books}/><strong data-truth-value={Number(citationSummary.separate)}>{truth(citationSummary.separate)}</strong></div><div class="dependence-verdict"><Math tex={dependenceTex.sharedSource}/><strong data-truth-value={Number(citationSummary.common)}>{truth(citationSummary.common)}</strong></div></>}
</figure>
