---
import Math from './Math.astro';
import MathText from './MathText.astro';
import {equivalenceText} from '../lib/reasoning/equivalence-copy';
import {isEquivalenceFigure,neighborhoods,remainder,type EquivalenceFigure} from '../lib/interactive/equivalence-model';
import {classesMarkup,chainMarkup} from '../lib/interactive/equivalence-render';
import '../styles/counterexamples.css';import '../styles/equivalence.css';
interface Props{kind:EquivalenceFigure}
const {kind}=Astro.props,locale=Astro.locals.locale||'en',c=equivalenceText(locale),neighbors=neighborhoods();
if(!isEquivalenceFigure(kind))throw new Error('Unknown equivalence figure');
---
<figure class="counter-figure equivalence-figure" data-equivalence-figure={kind}>
 <h3>{c.figures[kind]}</h3>
 {kind==='equivalence-opening'&&<div class="equivalence-opening" role="img" aria-label="4 ≠ 7"><strong>4</strong><span>≠</span><strong>7</strong></div>}
 {kind==='equivalence-machine'&&<><div class="equivalence-machines">{[4,7].map(n=><section class="equivalence-machine"><strong>{n}</strong><p aria-hidden="true">↓</p><div>{c.machine}</div><p aria-hidden="true">↓</p><strong class="equivalence-output">1</strong><Math tex={`${n}=3\\cdot ${n===4?1:2}+1`} display/></section>)}</div><figcaption>{c.same}</figcaption></>}
 {kind==='equivalence-tests'&&<div class="equivalence-tests">{c.testNames.map((name,i)=><section><h4>{i+1}. {name}</h4><svg viewBox="0 0 250 150" aria-hidden="true">{i===0?<><path d="M103 72C20-18 220-18 147 72" fill="none" stroke="var(--accent)" stroke-width="3"/><path d="m145 57 2 15 15-4" fill="none" stroke="var(--accent)" stroke-width="3"/><circle cx="125" cy="94" r="30" fill="var(--tint)" stroke="var(--accent)" stroke-width="3"/><text x="125" y="104" text-anchor="middle" fill="var(--text)" font-size="27">4</text></>:i===1?<><path d="M85 72H165l-10-8m10 8-10 8M165 98H85l10-8m-10 8 10 8" fill="none" stroke="var(--blue)" stroke-width="3"/>{[4,7].map((n,j)=><><circle cx={50+j*150} cy="85" r="30" fill="var(--blue-tint)" stroke="var(--blue)" stroke-width="3"/><text x={50+j*150} y="95" text-anchor="middle" fill="var(--text)" font-size="27">{n}</text></>)}</>:<><path d="M55 95H92M158 95H195M35 58Q125-15 215 58" fill="none" stroke="var(--purple)" stroke-width="3"/>{[4,7,10].map((n,j)=><><circle cx={30+j*95} cy="95" r="27" fill="var(--purple-tint)" stroke="var(--purple)" stroke-width="3"/><text x={30+j*95} y="104" text-anchor="middle" fill="var(--text)" font-size="23">{n}</text></>)}</>}</svg><p>{c.testDetails[i]}</p></section>)}</div>}
 {kind==='equivalence-chain'&&<div set:html={chainMarkup(locale,'question')}/>}
 {kind==='equivalence-partition'&&<div set:html={classesMarkup(locale)}/>}
 {kind==='equivalence-shared'&&<><p>{c.shared}</p><div class="equivalence-proof-step"><Math tex={String.raw`x\in[a]\cap[b]\quad\Longrightarrow\quad xRa\land xRb`} display/></div><div class="equivalence-proof-step"><Math tex={String.raw`aRx\land xRb\quad\Longrightarrow\quad aRb`} display/></div><p><MathText text={c.inclusion}/></p><div class="equivalence-proof-step"><Math tex={String.raw`[a]\subseteq[b]\;\land\;[b]\subseteq[a]\quad\Longrightarrow\quad[a]=[b]`} display/></div></>}
 {kind==='equivalence-classes'&&<><div class="equivalence-duo"><section><h4>{c.identical}</h4><svg viewBox="0 0 320 170" role="img" aria-label="A = B"><circle cx="160" cy="85" r="68" fill="var(--blue-tint)" stroke="var(--blue)" stroke-width="4"/><circle cx="160" cy="85" r="68" fill="none" stroke="var(--purple)" stroke-width="4" stroke-dasharray="10 10"/><text x="160" y="94" text-anchor="middle" fill="var(--text)" font-size="25">A = B</text></svg></section><section><h4>{c.disjoint}</h4><svg viewBox="0 0 320 170" role="img" aria-label="A ∩ B = ∅"><circle cx="77" cy="85" r="65" fill="var(--blue-tint)" stroke="var(--blue)" stroke-width="3"/><circle cx="243" cy="85" r="65" fill="var(--purple-tint)" stroke="var(--purple)" stroke-width="3"/><g text-anchor="middle" fill="var(--text)" font-size="25"><text x="77" y="94">A</text><text x="243" y="94">B</text></g></svg></section></div><figcaption>{c.impossible}</figcaption></>}
 {kind==='equivalence-neighborhoods'&&<><table class="equivalence-neighbors"><caption>{c.neighborhoods}</caption><thead><tr><th scope="col"></th>{[0,1,2,3].map(n=><th scope="col">{n}</th>)}</tr></thead><tbody>{[neighbors.left,neighbors.right].map((set,i)=><tr><th scope="row">N({i+1})</th>{[0,1,2,3].map(n=><td>{set.includes(n)?'∈':'∉'}</td>)}</tr>)}</tbody></table><Math tex={String.raw`N(1)\cap N(2)=\{1,2\},\qquad N(1)\ne N(2)`} display/></>}
 {kind==='equivalence-parity'&&<><div class="equivalence-duo">{[c.even,c.odd].map((name,r)=><section class="equivalence-parity"><h4>{name}</h4><ul>{Array.from({length:6},(_,i)=>2*i+r).map(n=><li>{n}</li>)}</ul><p aria-hidden="true">⋯</p></section>)}</div><figcaption>{c.parity}</figcaption></>}
 {kind==='equivalence-files'&&<><div class="equivalence-duo">{['notes.txt','copy.txt'].map(name=><div class="equivalence-file"><strong>{name}</strong><code>Hello, world!</code></div>)}</div><figcaption>{c.files}</figcaption></>}
 {kind==='equivalence-quotient'&&<><div class="equivalence-quotient">{[-2,-1,0,1,2].map(n=><span>{n} → [{remainder(n)}]</span>)}</div><Math tex={String.raw`\mathbb Z\longrightarrow\{[0],[1],[2]\},\qquad n\longmapsto[n]`} display/><figcaption>{c.quotient}</figcaption></>}
</figure>
