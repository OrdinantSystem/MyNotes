---
import Math from './Math.astro';import MathText from './MathText.astro';import Flow from './Flow.astro';
import {justificationText} from '../lib/reasoning/justification-copy';
import {oddExamples,proofDependencies,isJustificationFigure,type JustificationFigure} from '../lib/interactive/justification-model';
import {oddObjectsMarkup,representationTex} from '../lib/interactive/justification-render';
import '../styles/counterexamples.css';import '../styles/justification.css';
interface Props{kind:JustificationFigure}
const {kind}=Astro.props,locale=Astro.locals.locale||'en',c=justificationText(locale),id=`justification-${crypto.randomUUID()}`;
if(!isJustificationFigure(kind))throw new Error('Unknown justification figure');
const nodes=[['assumption',1,1],['odd-definition',3,1],['representation',2,2],['algebra',2,3],['closure',1,4],['even-definition',3,4],['conclusion',2,5]] as const;
const paths=['M219 120L410 181','M681 120L490 181','M450 304V365','M231 244H100V530H219V549','M450 488V733','M219 672L410 733','M681 672L490 733'];
const repair=[representationTex[1],String.raw`a+b=2k+2m+2`,representationTex[2]].map((tex,i)=>({label:c.repairReasons[i],tex,detail:i===2?c.repairConclusion:''}));
const foundationPaths=['M450 100L150 161','M450 100V161','M450 100L750 161','M150 264L300 325','M450 264L300 325','M450 264L600 325','M750 264L600 325'];
---
{kind==='justification-repair'?<div class="justification-repair"><h3>{c.figures[kind]}</h3><Flow nodes={repair} caption={c.repairConclusion}/></div>:<figure class="counter-figure justification-figure" data-justification-figure={kind}>
 <h3>{c.figures[kind]}</h3>
 {kind==='justification-examples'&&<div class="justification-three">{oddExamples.map(([a,b])=><section><Math tex={`${a}+${b}`} display/><p aria-hidden="true">↓</p><p class="justification-result">{a+b}</p><p>{c.even}</p></section>)}</div>}
 {kind==='justification-dependencies'&&<><div class="justification-network-board"><svg class="justification-network-lines" viewBox="0 0 900 856" preserveAspectRatio="none" aria-hidden="true"><defs><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M1 1L7 4L1 7"/></marker></defs>{paths.map(d=><path d={d} marker-end={`url(#${id}-arrow)`}/>)}</svg>{nodes.map(([key,column,row])=><section class="justification-network-node" data-node={key} style={`grid-column:${column}/span 2;grid-row:${row}`}><h4>{c.networkLabels[key]}</h4><p><MathText text={c.networkText[key]}/></p></section>)}</div><ul class="justification-edge-list">{proofDependencies.map(([from,to])=><li>{c.networkLabels[from]} → {c.networkLabels[to]}</li>)}</ul><figcaption>{c.dependencyCaption}</figcaption></>}
 {kind==='justification-foundations'&&<><div class="justification-network-board justification-foundations-network"><svg class="justification-network-lines" viewBox="0 0 900 428" preserveAspectRatio="none" aria-hidden="true"><defs><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M1 1L7 4L1 7"/></marker></defs>{foundationPaths.map(d=><path d={d} marker-end={`url(#${id}-arrow)`}/>)}</svg><section class="justification-network-node" style="grid-column:2/span 4;grid-row:1"><h4>{c.foundations}</h4></section>{[1,2,3].map((n,i)=><section class="justification-network-node" style={`grid-column:${1+2*i}/span 2;grid-row:2`}><h4>{c.earlier} {n}</h4></section>)}{c.newTheorems.map((name,i)=><section class="justification-network-node" style={`grid-column:${2+2*i}/span 2;grid-row:3`}><h4>{name}</h4></section>)}</div><ul class="justification-edge-list">{[1,2,3].map(n=><li>{c.foundations} → {c.earlier} {n}</li>)}<li>{c.earlier} 1 + 2 → {c.newTheorems[0]}</li><li>{c.earlier} 2 + 3 → {c.newTheorems[1]}</li></ul><figcaption>{c.foundationCaption}</figcaption></>}
 {kind==='justification-lemmas'&&<><div class="justification-two"><section><h4>{c.resultA}</h4><p>{c.odd} + {c.odd} → {c.even}</p></section><section><h4>{c.resultB}</h4><p>{c.even} + {c.odd} → {c.odd}</p></section></div><Math tex={locale==='de'?String.raw`\underbrace{(a+b)}_{\text{gerade}}+\underbrace{c}_{\text{ungerade}}`:String.raw`\underbrace{(a+b)}_{\text{even}}+\underbrace{c}_{\text{odd}}`} display/><figcaption><MathText text={c.lemmaConclusion}/></figcaption></>}
 {kind==='justification-roles'&&<div class="justification-three"><section><h4>{c.roles[0]}</h4>{oddExamples.map(([a,b])=><Math tex={`${a}+${b}=${a+b}`} display/>)}<p>{c.roleDetails[0]}</p></section><section><h4>{c.roles[1]}</h4><div set:html={oddObjectsMarkup(locale,0,0)}/><p>{c.roleDetails[1]}</p></section><section><h4>{c.roles[2]}</h4><Math tex={String.raw`a=2k+1,\quad b=2m+1`} display/><Math tex={String.raw`a+b=2t`} display/><Math tex={String.raw`t=k+m+1\in\mathbb Z`} display/><p>{c.roleDetails[2]}</p></section></div>}
 {kind==='justification-counterexample'&&<><Math tex={String.raw`1+5=6=2\cdot3,\qquad4\nmid6`} display/><figcaption><MathText text={c.counterexample}/></figcaption></>}
</figure>}
