---
import {figureMarkup} from './render';
import {text} from './copy';
import './styles.css';
interface Props{figure:string}
const {figure}=Astro.props,locale=Astro.locals.locale||'en',c=text(locale);
if(!(figure in c.figures))throw new Error('Unknown proof workshop figure');
---
<figure class="a63-figure" data-a63-figure={figure}><h3>{c.figures[figure as keyof typeof c.figures]}</h3><div set:html={figureMarkup(locale,figure)}/></figure>
