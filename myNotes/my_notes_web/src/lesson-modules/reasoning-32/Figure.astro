---
import Math from '../../components/Math.astro';
import {copy} from './copy';
import {oddStatement} from './model';
import '../../styles/counterexamples.css';
import './workshop.css';
interface Props{figure:string}
const {figure}=Astro.props,locale=Astro.locals.locale==='de'?'de':'en',c=copy(locale),title=c.titles[figure as keyof typeof c.titles];
if(!title)throw new Error(`Unknown workshop figure: ${figure}`);
const rules=[[c.two,c.twoDetail],[c.consecutive,c.consecutiveDetail],[c.positive,c.positiveDetail]];
const examples=[['9=4+5',c.valid],['9=2+3+4',c.valid],['9=2+7',c.notConsecutive],['1=0+1',c.notPositive],['9=9',c.oneTerm]];
---
<figure class="counter-figure aor32" data-aor32-figure={figure}>
 <h3>{title}</h3>
 {figure==='sums'&&<>{[[7,8],[4,5,6],[1,2,3,4,5]].map(row=><div class="aor32-row">{row.map((n,i)=><>{i>0&&<span aria-hidden="true">+</span>}<span class="aor32-term">{n}</span></>)}<strong class="aor32-number">= 15</strong></div>)}<figcaption>{c.sumCaption}</figcaption></>}
 {figure==='restrictions'&&<><div class="aor32-grid">{rules.map(([name,detail])=><div class="aor32-card"><h4>{name}</h4><p>{detail}</p></div>)}</div>{examples.map(([tex,label])=><div class="aor32-math-row"><Math tex={tex}/><span>{label}</span></div>)}</>}
 {figure==='workspace'&&<div class="aor32-grid"><section class="aor32-card aor32-established"><h4>{c.facts}</h4>{['15=7+8','15=4+5+6','15=1+2+3+4+5'].map(tex=><Math tex={tex} display/>)}</section><section class="aor32-card aor32-pending"><h4>{c.conjectures}</h4><p>{c.empty}</p></section><section class="aor32-card aor32-question"><h4>{c.questions}</h4><p>{c.unsettled}</p></section></div>}
 {figure==='odd-growth'&&<>{[1,2,3,4,5].map(k=><div class="aor32-row"><strong class="aor32-number">{2*k+1} =</strong><div class="aor32-group" aria-label={String(k)}>{Array.from({length:k},()=> <i class="aor32-unit" aria-hidden="true"/>)}</div><span>+</span><div class="aor32-group" aria-label={String(k+1)}>{Array.from({length:k+1},()=> <i class="aor32-unit aor32-extra" aria-hidden="true"/>)}</div></div>)}<figcaption>{c.growthCaption}</figcaption></>}
 {figure==='counterexample'&&<><section class="aor32-card aor32-pending"><h4>{c.possible}</h4><p>{oddStatement[locale]}</p></section><section class="aor32-card aor32-excluded"><h4>{c.rejected}</h4><p><s>{c.onlyOdd}</s></p><Math tex="6=1+2+3" display/><p>{c.counter}</p></section></>}
 {figure==='inclusion'&&<><div class="aor32-set"><h4>{c.represented}</h4><div class="aor32-subset"><h4>{c.oddSet}</h4><Math tex="3,5,7,9,11,13,\ldots" display/></div><Math tex="6,10,12,14,\ldots" display/></div><div class="aor32-card aor32-pending"><h4>{c.pending}</h4><Math tex="4,8,16,\ldots" display/></div><div class="aor32-card aor32-excluded"><h4>{c.excluded}</h4><Math tex="1,2" display/></div><Math tex="O\subsetneq S" display/><figcaption>{c.inclusionCaption}</figcaption></>}
 {figure==='eight'&&<><div class="aor32-scroll" tabindex="0" role="region" aria-label={title}><svg viewBox="0 0 580 250" role="img" aria-label={c.eightCases.join(' ')}><rect x="372" y="32" width="30" height="192" rx="8" fill="var(--coral-tint)" stroke="var(--coral)" stroke-dasharray="5 4"/>{Array.from({length:12},(_,i)=><text class={i===7?'aor32-target':undefined} x={135+i*36} y="22">{i+1}</text>)}{[[3,5,7,9,11],[6,9,12],[10]].map((row,j)=><><text x="60" y={75+j*65}>{j+2} {c.terms}</text><line x1="130" y1={70+j*65} x2="545" y2={70+j*65}/>{row.map(n=><circle cx={135+(n-1)*36} cy={70+j*65} r="9" class="aor32-point"/>)}</>)}</svg></div><ul>{c.eightCases.map(line=><li>{line}</li>)}</ul><p class="aor32-card aor32-excluded"><strong>{c.eightConclusion}</strong></p></>}
 {figure==='obligations'&&<><p class="aor32-card aor32-pending">{c.notPower}</p><div class="counter-columns"><div class="aor32-card"><div class="aor32-arrow" aria-hidden="true">↓</div><p>{c.construct}</p></div><div class="aor32-card"><div class="aor32-arrow" aria-hidden="true">↑</div><p>{c.ruleOut}</p></div></div><p class="aor32-card aor32-pending">{c.hasRepresentation}</p><figcaption>{c.both}</figcaption></>}
 {figure==='final-workspace'&&<><div class="aor32-stack"><section class="aor32-card aor32-established"><h4>{c.facts}</h4><p>{oddStatement[locale]}</p><p>{c.someEven}</p><p>{c.smallExcluded}</p></section><section class="aor32-card aor32-pending"><h4>{c.conjectures}</h4><p>{c.classification}</p></section><section class="aor32-card aor32-question"><h4>{c.questions}</h4>{c.open.map(line=><p>{line}</p>)}</section></div><figcaption>{c.finalCaption}</figcaption></>}
 {figure==='cycle'&&<><div class="aor32-stack">{c.cycleNames.map((name,i)=><>{i>0&&<div class="aor32-arrow" aria-hidden="true">↓</div>}<div class:list={['aor32-card',i===4?'aor32-established':i===3?'aor32-pending':'aor32-question']}><h4>{name}</h4><p>{c.cycleDetails[i]}</p></div></>)}<div class="aor32-arrow">↶ {c.cycleNames[0]}</div></div></>}
</figure>
