---
import './styles.css';
import {text} from './copy';
import {regroupMarkup,baseMarkup,workshopMarkup} from './render';
interface Props {preset:'opening'|'regroup'|'base-rate'|'workshop';id:string}
const {preset,id}=Astro.props,locale=Astro.locals.locale||'en',c=text(locale);
---
<figure class="detector-view" id={id} data-detector-lab={preset} data-locale={locale}>
 <h3>{preset==='opening'?c.opening:preset==='regroup'?c.regroup:preset==='base-rate'?c.base:c.workshop}</h3>
 {preset==='opening'?<><fieldset><legend>{c.chooseFirst}</legend><div class="detector-answers">{c.choices.map((choice,i)=><label><input type="radio" name={`${id}-answer`} value={i} data-detector-choice aria-controls={`${id}-output`}/>{choice}</label>)}</div></fieldset><div id={`${id}-output`} data-detector-output></div></>:preset==='regroup'?<><div class="detector-controls">{(['actual','result','flagged'] as const).map((stage,i)=><button type="button" data-detector-stage={stage} aria-pressed={i===0} aria-controls={`${id}-output`}>{[c.actual,c.result,c.only][i]}</button>)}</div><div id={`${id}-output`} data-detector-output set:html={regroupMarkup(locale,'actual')}/></>:preset==='base-rate'?<><div class="detector-controls"><label>{c.rate}<input type="number" min="1" max="50" step="1" value="1" data-detector-rate aria-controls={`${id}-output`}/></label></div><label for={`${id}-range`}>{c.rate}</label><input id={`${id}-range`} type="range" min="1" max="50" step="1" value="1" data-detector-range aria-controls={`${id}-output`}/><div class="detector-controls">{[1,10,50].map((rate,i)=><button type="button" data-detector-rate-preset={rate} aria-pressed={i===0} aria-controls={`${id}-output`}>{[c.rare,c.ten,c.equal][i]}</button>)}</div><div id={`${id}-output`} data-detector-output set:html={baseMarkup(locale,1)}/><p>{c.exact}</p></>:<><p>{c.workshopGiven}</p><div class="detector-controls"><label>{c.estimate}<input type="number" min="0" max="100" step="any" data-detector-estimate/></label></div><p>{c.private}</p><details data-detector-solution><summary>{c.reveal}</summary><div id={`${id}-output`} data-detector-output set:html={workshopMarkup(locale)}/></details></>}
 <div class="detector-controls"><button type="button" data-detector-reset>{c.reset}</button></div><p class="detector-status" role="status" aria-live="polite" data-detector-status></p>
</figure>
<script>
import {rateInput,estimateInput,type Stage} from './model';
import {text,type DetectorLocale} from './copy';
import {regroupMarkup,baseMarkup,p} from './render';
for(const root of document.querySelectorAll<HTMLElement>('[data-detector-lab]')){
 const c=text(root.dataset.locale as DetectorLocale),locale=root.dataset.locale as DetectorLocale,preset=root.dataset.detectorLab;
 const output=root.querySelector<HTMLElement>('[data-detector-output]')!,status=root.querySelector<HTMLElement>('[data-detector-status]')!;let stage:Stage='actual',rate=1;
 const numeric=root.querySelector<HTMLInputElement>('[data-detector-rate]'),range=root.querySelector<HTMLInputElement>('[data-detector-range]'),estimate=root.querySelector<HTMLInputElement>('[data-detector-estimate]'),solution=root.querySelector<HTMLDetailsElement>('[data-detector-solution]');
 function draw(){
  if(preset==='regroup'){output.innerHTML=regroupMarkup(locale,stage);root.querySelectorAll<HTMLButtonElement>('[data-detector-stage]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.detectorStage===stage)));}
  if(preset==='base-rate'){numeric!.value=range!.value=String(rate);output.innerHTML=baseMarkup(locale,rate);root.querySelectorAll<HTMLButtonElement>('[data-detector-rate-preset]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.detectorRatePreset)===rate)));}
 }
 root.querySelectorAll<HTMLInputElement>('[data-detector-choice]').forEach(input=>input.addEventListener('change',()=>{output.innerHTML=p(c.openingFeedback);status.textContent=c.openingFeedback;}));
 root.querySelectorAll<HTMLButtonElement>('[data-detector-stage]').forEach(b=>b.addEventListener('click',()=>{stage=b.dataset.detectorStage as Stage;draw();status.textContent=c.selection;}));
 function commit(raw:string){const n=rateInput(raw);if(n===null){draw();status.textContent=c.invalidRate;return;}rate=n;draw();status.textContent=`${c.rate}: ${rate}. ${c.changeNote}`;}
 numeric?.addEventListener('change',()=>commit(numeric.value));range?.addEventListener('input',()=>commit(range.value));
 root.querySelectorAll<HTMLButtonElement>('[data-detector-rate-preset]').forEach(b=>b.addEventListener('click',()=>commit(b.dataset.detectorRatePreset!)));
 estimate?.addEventListener('input',()=>{solution!.open=false;status.textContent=estimate.value.trim()===''?'':estimateInput(estimate.value)===null?c.invalidEstimate:c.private;});
 solution?.addEventListener('toggle',()=>{if(solution.open){const value=estimateInput(estimate!.value);status.textContent=estimate!.value.trim()===''?c.missingEstimate:value===null?c.invalidEstimate:`${c.recorded}: ${value}%. ${c.private}`;}});
 root.querySelector('[data-detector-reset]')!.addEventListener('click',()=>{stage='actual';rate=1;root.querySelectorAll<HTMLInputElement>('[data-detector-choice]').forEach(x=>x.checked=false);if(preset==='opening')output.replaceChildren();if(estimate)estimate.value='';if(solution)solution.open=false;draw();status.textContent=c.reset;});
}
</script>
