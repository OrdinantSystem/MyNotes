---
import './styles.css';
import {figureMarkup} from './render';
import {text} from './copy';
import type {Locale} from './model';
interface Props {figure:string}
const {figure}=Astro.props,locale=(Astro.locals.locale||'en') as Locale,c=text(locale);
---
<figure class="research-view" data-research-figure={figure}><h3>{c.titles[figure as keyof typeof c.titles]}</h3><div set:html={figureMarkup(locale,figure)}/></figure>
