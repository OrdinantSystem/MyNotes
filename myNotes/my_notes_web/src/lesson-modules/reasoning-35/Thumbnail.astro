---
interface Props{locale?:'en'|'de'}
const {locale='en'}=Astro.props;
---
<svg viewBox="0 0 220 130" role="img" aria-label={locale==='de'?'Eine Stichprobe wird durch einen Auswahlprozess aus einer Grundgesamtheit gewonnen':'A selection process connects a population and a sample'}>
 {Array.from({length:25},(_,i)=><circle cx={25+i%5*13} cy={30+Math.floor(i/5)*16} r="4" fill={i%5<3?'var(--blue)':'var(--purple)'}/>)}
 <path d="M100 65H132m-7-6 7 6-7 6" fill="none" stroke="var(--axis)" stroke-width="2"/>
 <rect x="143" y="32" width="60" height="65" rx="6" fill="var(--surface)" stroke="var(--accent)"/>
 {[0,1,2,3,4,5].map(i=><circle cx={157+i%3*15} cy={53+Math.floor(i/3)*24} r="5" fill={i<4?'var(--blue)':'var(--purple)'}/>)}
</svg>
