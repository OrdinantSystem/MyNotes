---
import {copy,figureMarkup} from './render';
import './style.css';
interface Props {figure:string}
const {figure}=Astro.props,locale=Astro.locals.locale||'en',c=copy(locale);
---
<figure class="aor30" data-counting-figure={figure}><h3>{c.titles[figure as keyof typeof c.titles]}</h3><div set:html={figureMarkup(locale,figure)}/></figure>
