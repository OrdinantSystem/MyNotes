---
import {figureMarkup} from './render';
import {copy} from './copy';
import './styles.css';
interface Props {figure:string}
const {figure}=Astro.props,locale=Astro.locals.locale||'en',c=copy(locale);
if(!(figure in c.figures))throw new Error('Unknown observation figure');
---
<figure class="aor33-figure" data-aor33-figure={figure}><h3>{c.figures[figure as keyof typeof c.figures]}</h3><div set:html={figureMarkup(locale,figure)}/></figure>
