---
import {lessonModules} from '../lib/lesson-modules.mjs';
import {uniquenessPresets,uniquenessFigures} from '../lib/interactive/uniqueness-model';
import {strongPresets,strongFigures} from '../lib/interactive/strong-model';
import {lemmaPresets,lemmaFigures} from '../lib/interactive/lemma-model';
import {reframePresets,reframeFigures} from '../lib/interactive/reframe-model';
import {trianglePresets,triangleFigures} from '../lib/interactive/triangle-model';
import {transferPresets,transferFigures} from '../lib/interactive/transfer-model';
import {auditPresets,auditFigures} from '../lib/interactive/audit-model';
import {inductionPresets,inductionFigures} from '../lib/interactive/induction-model';
import {contradictionPresets,contradictionFigures} from '../lib/interactive/contradiction-model';
import {contraPresets,contraFigures,type ContraFigure} from '../lib/interactive/contraposition-model';
import {casesPresets,casesFigures} from '../lib/interactive/cases-model';
import {discoveryPresets,discoveryFigures} from '../lib/interactive/discovery-model';
import {justificationPresets,justificationFigures} from '../lib/interactive/justification-model';
import {equivalencePresets,equivalenceFigures} from '../lib/interactive/equivalence-model';
import {worldPresets,worldFigures} from '../lib/interactive/world-model';
import {dependencePresets,dependenceFigures} from '../lib/interactive/dependence-model';
import {switchPresets,switchFigures} from '../lib/interactive/switch-model';
import {conditionalFigures} from '../lib/interactive/conditional-model';
import {languagePresets,languageFigures} from '../lib/interactive/language-model';
import {argumentPresets,argumentFigures} from '../lib/interactive/argument-model';
import {inquiryPresets} from '../lib/interactive/inquiry-model';
import {validityPresets,validityFigureKinds} from '../lib/interactive/validity-model';
import {counterPresets,counterFigureKinds} from '../lib/interactive/counterexample-model';
import {patternFigureKinds} from '../lib/interactive/patterns-model';
import {proofFigureKinds} from '../lib/interactive/parity-model';
import {equationPresetNames} from '../lib/interactive/equation-model';
import {algebraFigureKinds} from '../lib/interactive/algebra-model';
import {teachingMap} from '../lib/learning/mind-map-presets';
import NumberDomains from '../components/NumberDomains.astro';
import ExpressionTrees from '../components/ExpressionTrees.astro';
import ProcessDiagram from '../components/ProcessDiagram.astro';
import LearningFigure from '../components/LearningFigure.astro';
import QuestionLens from '../components/QuestionLens.astro';
import StudyTemplate from '../components/StudyTemplate.astro';
import RelationMap from '../components/RelationMap.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import MatrixComparison from '../components/MatrixComparison.astro';
import Interactive from '../components/interactive/Interactive.astro';
import VectorFigure from '../components/VectorFigure.astro';
import {assets} from '../lib/interactive/catalog';
import ReasoningFigure from '../components/ReasoningFigure.astro';
import AnalysisProof from '../components/AnalysisProof.astro';
import LogicFigure from '../components/LogicFigure.astro';
import RecallChecklist from '../components/RecallChecklist.astro';
Astro.locals.locale='en';
---
<SiteLayout title="Representation library" description="Reusable teaching assets and authoring examples." locale="en" current="library">
  <meta slot="head" name="robots" content="noindex"/>
  <header class="article-header"><span class="section-label">AUTHORING REFERENCE</span><h1>Representation library</h1></header>
  <div class="prose">
    <p>This English authoring reference is outside lesson search and the learner navigation. The examples below are working components. Use the same snippets inside MDX lessons, with localized prose and a unique id for each vector activity.</p>
    <ul>{assets.map(asset=><li><a href={`#${asset.id}`}>{asset.name}</a> — {asset.purpose}</li>)}</ul>
    {assets.map(asset=><section id={asset.id}>
      <h2>{asset.name}</h2><p>{asset.purpose}</p><pre><code>{asset.example}</code></pre>
      {lessonModules.filter(m=>asset.id===`module-${m.id}`).map(m=><>{m.presets.map((preset:string)=><Interactive kind="module" module={m.id} preset={preset} id={`library-${m.id}-${preset}`}/>)}{m.presets.length>0&&<Interactive kind="module" module={m.id} preset={m.presets[0]} id={`library-${m.id}-independent`}/>} {m.figures.map((figure:string)=><ReasoningFigure kind="module" module={m.id} figure={figure}/>)}</>)}
      {asset.id==='logic-revision' &&<>{(['concept-map','predicate-mapping','proof-paths'] as const).map(kind=><LogicFigure kind={kind}/>)}<RecallChecklist items={['Explain a statement and an open formula.','Read $P:\\mathbb N\\to\\{0,1\\}$.']}/></>}
      {asset.id==='uniqueness-labs'&&<>{uniquenessPresets.map(preset=><Interactive kind="uniqueness" preset={preset} id={`library-uniqueness-${preset}`}/>)}<Interactive kind="uniqueness" preset="machine" id="library-uniqueness-independent"/></>}
      {asset.id==='uniqueness-figures'&&uniquenessFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='strong-labs'&&<>{strongPresets.map(preset=><Interactive kind="strong" preset={preset} id={`library-strong-${preset}`}/>)}<Interactive kind="strong" preset="tree" id="library-strong-independent"/></>}
      {asset.id==='strong-figures'&&strongFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='lemma-labs'&&<>{lemmaPresets.map(preset=><Interactive kind="lemma" preset={preset} id={`library-lemma-${preset}`}/>)}<Interactive kind="lemma" preset="bridge" id="library-lemma-independent"/></>}
      {asset.id==='lemma-figures'&&lemmaFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='reframe-labs'&&<>{reframePresets.map(preset=><Interactive kind="reframe" preset={preset} id={`library-reframe-${preset}`}/>)}<Interactive kind="reframe" preset="construction" id="library-reframe-independent"/></>}
      {asset.id==='reframe-figures'&&reframeFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='triangle-labs'&&<>{trianglePresets.map(preset=><Interactive kind="triangle" preset={preset} id={`library-triangle-${preset}`}/>)}<Interactive kind="triangle" preset="puzzle" id="library-triangle-independent"/></>}
      {asset.id==='triangle-figures'&&triangleFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='transfer-labs'&&<>{transferPresets.map(preset=><Interactive kind="transfer" preset={preset} id={`library-transfer-${preset}`}/>)}<Interactive kind="transfer" preset="calibration" id="library-transfer-independent"/></>}
      {asset.id==='transfer-figures'&&transferFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='audit-labs'&&<>{auditPresets.map(preset=><Interactive kind="audit" preset={preset} id={`library-audit-${preset}`}/>)}<Interactive kind="audit" preset="cancellation" id="library-audit-independent"/></>}
      {asset.id==='audit-figures'&&auditFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='induction-labs'&&<>{inductionPresets.map(preset=><Interactive kind="induction" preset={preset} id={`library-induction-${preset}`}/>)}<Interactive kind="induction" preset="tiles" id="library-induction-independent"/></>}
      {asset.id==='induction-figures'&&inductionFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='contradiction-labs'&&<>{contradictionPresets.map(preset=><Interactive kind="contradiction" preset={preset} id={`library-contradiction-${preset}`}/>)}<Interactive kind="contradiction" preset="prime-builder" id="library-contradiction-independent"/></>}
      {asset.id==='contradiction-figures'&&contradictionFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='contraposition-labs'&&<>{contraPresets.map(preset=><Interactive kind="contraposition" preset={preset} id={`library-contra-${preset}`}/>)}<Interactive kind="contraposition" preset="truth" id="library-contra-independent"/></>}
      {asset.id==='contraposition-figures'&&contraFigures.map(kind=><ReasoningFigure kind={kind as ContraFigure}/>)}
      {asset.id==='cases-labs'&&<>{casesPresets.map(preset=><Interactive kind="cases" preset={preset} id={`library-cases-${preset}`}/>)}<Interactive kind="cases" preset="consecutive" id="library-cases-independent"/></>}
      {asset.id==='cases-figures'&&casesFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='discovery-labs'&&<>{discoveryPresets.map(preset=><Interactive kind="discovery" preset={preset} id={`library-discovery-${preset}`}/>)}<Interactive kind="discovery" preset="workspace" id="library-discovery-independent"/></>}
      {asset.id==='discovery-figures'&&discoveryFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='justification-labs'&&<>{justificationPresets.map(preset=><Interactive kind="justification" preset={preset} id={`library-justification-${preset}`}/>)}<Interactive kind="justification" preset="representations" id="library-justification-independent"/></>}
      {asset.id==='justification-figures'&&justificationFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='equivalence-labs'&&<>{equivalencePresets.map(preset=><Interactive kind="equivalence" preset={preset} id={`library-equivalence-${preset}`}/>)}<Interactive kind="equivalence" preset="sorting" id="library-equivalence-independent"/></>}
      {asset.id==='equivalence-figures'&&equivalenceFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='world-labs'&&<>{worldPresets.map(preset=><Interactive kind="worlds" preset={preset} id={`library-world-${preset}`}/>)}<Interactive kind="worlds" preset="operations" id="library-world-independent"/></>}
      {asset.id==='world-figures'&&worldFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='dependence-labs'&&<>{dependencePresets.map(preset=><Interactive kind="dependence" preset={preset} id={`library-dependence-${preset}`}/>)}<Interactive kind="dependence" preset="network" id="library-dependence-independent"/></>}
      {asset.id==='dependence-figures'&&dependenceFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='switch-labs'&&<>{switchPresets.map(preset=><Interactive kind="switches" preset={preset} id={`library-switch-${preset}`} group={preset==='routes'||preset==='simplify'?'library-switch-repair':undefined}/>)}<Interactive kind="switches" preset="access" id="library-switch-independent"/></>}
      {asset.id==='switch-figures'&&switchFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='conditional-labs'&&<><Interactive kind="conditional" preset="numbers" id="library-conditional-numbers"/><Interactive kind="conditional" preset="numbers" id="library-conditional-independent"/></>}
      {asset.id==='conditional-figures'&&conditionalFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='language-labs'&&languagePresets.map(preset=><Interactive kind="language" preset={preset} id={`library-language-${preset}`} group={['interpretations','scores','median','tests'].includes(preset)?'library-language-scores':undefined}/>)}
      {asset.id==='language-figures'&&languageFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='argument-labs'&&argumentPresets.map(preset=><Interactive kind="arguments" preset={preset} id={`library-argument-${preset}`}/>)}
      {asset.id==='argument-figures'&&argumentFigures.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='inquiry-labs'&&inquiryPresets.map(preset=><Interactive kind="inquiry" preset={preset} id={`library-inquiry-${preset}`}/>)}
      {asset.id==='inquiry-figures'&&(['inquiry-opening','inquiry-successes','inquiry-cycle'] as const).map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='validity-labs' &&validityPresets.map(preset=><Interactive kind="validity" preset={preset} id={`library-validity-${preset}`}/>)}
      {asset.id==='validity-figures'&&validityFigureKinds.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='counterexample-labs' &&counterPresets.map(preset=><Interactive kind="counterexamples" preset={preset} id={`library-counter-${preset}`}/>)}
      {asset.id==='counterexample-figures'&&counterFigureKinds.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='pattern-explorers'&&(['continuations','next-test'] as const).map(preset=><Interactive kind="patterns" preset={preset} id={`library-pattern-${preset}`}/>)}
      {asset.id==='pattern-figures'&&patternFigureKinds.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='proof-pairs'&&<Interactive kind="parity" preset="even-sum" id="library-complete-pairs"/>}
      {asset.id==='proof-figures'&&proofFigureKinds.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='equation-transformations' &&equationPresetNames.map(preset=><Interactive kind="equations" preset={preset} id={`library-equation-${preset}`}/>)}
    {asset.id==='equation-solutions'&&<ReasoningFigure kind="squared-solutions"/>}
    {asset.id==='algebra-models'&&(['tables','grouping'] as const).map(preset=><Interactive kind="algebra" preset={preset} id={`library-algebra-${preset}`}/>)}
      {asset.id==='algebra-figures'&&algebraFigureKinds.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='reasoning-comparisons'&&(['appearance','units','water'] as const).map(preset=><Interactive kind="reasoning" preset={preset} id={`library-reasoning-${preset}`}/>)}
      {asset.id==='reasoning-figures'&&(['opening','collections','objects','singleton','singletons','matching','addition','overlap','pairs','function','symbols','process'] as const).map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='analysis-candidates'&&['equation','positive','witnesses'].map((preset)=><Interactive kind="candidates" preset={preset as 'equation'|'positive'|'witnesses'} id={`library-candidates-${preset}`}/>)}
      {asset.id==='analysis-conditions'&&['connectives','construction','demorgan'].map((preset)=><Interactive kind="conditions" preset={preset as 'connectives'|'construction'|'demorgan'} id={`library-conditions-${preset}`}/>)}
      {asset.id==='analysis-number-line'&&['bounds','complement','counterexample','distance'].map((preset)=><Interactive kind="number-line" preset={preset as 'bounds'|'complement'|'counterexample'|'distance'} id={`library-line-${preset}`}/>)}
      {asset.id==='analysis-quantifiers'&&<Interactive kind="quantifiers" preset="keys" id="library-keys"/>}
      {asset.id==='analysis-quantifiers'&&<Interactive kind="quantifiers" preset="keys" presentation="witnesses" id="library-keys-focused"/>}
      {asset.id==='analysis-quantifiers'&&<Interactive kind="quantifiers" preset="nested" id="library-nested"/>}
      {asset.id==='analysis-sequence'&&<Interactive kind="sequence" preset="reciprocal" id="library-tail"/>}
      {asset.id==='analysis-candidates'&&<Interactive kind="candidates" preset="equation" presentation="input" id="library-input-focused"/>}
      {asset.id==='analysis-sequence'&&<Interactive kind="sequence" preset="device" presentation="terms" id="library-terms-focused"/>}
      {asset.id==='analysis-sequence'&&<Interactive kind="sequence" preset="reciprocal" presentation="tail" id="library-tail-focused"/>}
      {asset.id==='analysis-proof'&&['equivalence','scope','contradiction','complement'].map(preset=><AnalysisProof preset={preset as 'equivalence'|'scope'|'contradiction'|'complement'}/>)}
      {asset.id==='mind-map'&&<Interactive kind="mind-map" preset="study-session" id="library-study-map"/>}
      {asset.id==='mind-map'&&<><p>A different graph supplied through the typed data API:</p><pre><code>{'<Interactive kind="mind-map" data={teachingMap} id="library-teaching-map" />'}</code></pre><Interactive kind="mind-map" data={teachingMap} id="library-teaching-map"/></>}
      {asset.id==='relation-map'&&<RelationMap/>}
      {asset.id==='learning-cycle'&&<ProcessDiagram preset="cycle" id="library-learning-cycle"/>}
      {asset.id==='learning-mapping'&&<LearningFigure kind="mapping"/>}
      {asset.id==='learning-methods'&&<LearningFigure kind="methods"/>}
      {asset.id==='learning-practice'&&<LearningFigure kind="interleaving"/>}
      {asset.id==='learning-spacing'&&<LearningFigure kind="spacing"/>}
      {asset.id==='learning-bloom'&&<QuestionLens/>}
      {asset.id==='learning-template'&&<StudyTemplate kind="session"/>}
      {asset.id==='logic'&&<Interactive kind="logic" preset="implication" id="library-logic"/>}
      {asset.id==='nand'&&<Interactive kind="logic" preset="nand" id="library-nand"/>}
      {asset.id==='number-domains'&&<NumberDomains/>}
      {asset.id==='expression-trees'&&<ExpressionTrees variant="distributivity"/>}
      {asset.id==='comparison'&&<MatrixComparison cases={[{matrix:[[1,0],[0,1]],label:'Unit area',detail:'det = 1'},{matrix:[[1,0],[0,2]],label:'Double area',detail:'det = 2'},{matrix:[[1,0],[0,0]],label:'Collapsed area',detail:'det = 0'}]} caption="The dashed square is the input; colored columns and the filled image share one matrix."/>}
      {asset.id==='area'&&<Interactive kind="vectors" preset="area-and-orientation" id="library-area"/>}
      {asset.id==='combination'&&<Interactive kind="vectors" preset="linear-combination" id="library-combination"/>}
      {asset.id==='coordinate-basis'&&<Interactive kind="vectors" preset="coordinate-basis" id="library-coordinate-basis"/>}
      {asset.id==='rank'&&<Interactive kind="vectors" preset="rank-collapse" id="library-rank"/>}
      {asset.id==='matrix'&&<Interactive kind="matrix-product" left={[[1,2,3],[0,-1,2]]} right={[[1,0],[2,1],[0,3]]}/>}
      {asset.id==='rotation'&&<Interactive kind="rotation"/>}
      {asset.id==='shear'&&<Interactive kind="shear"/>}
      {asset.id==='figure'&&<VectorFigure description="Two displacements placed head to tail" caption="The second displacement starts at the first tip." vectors={[{to:[2,1],label:'u'},{from:[2,1],to:[3,3],label:'v',role:'blue'}]}/>}
    </section>)}
  </div>
</SiteLayout>
